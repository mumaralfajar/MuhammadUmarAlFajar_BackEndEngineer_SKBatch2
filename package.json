{
  "name": "sekolah-karir",
  "version": "1.0.0",
  "private": true,
  "description": "Applicant records API built with Hono, Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sekolah-karir-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sekolah-karir-db --remote",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261109.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
