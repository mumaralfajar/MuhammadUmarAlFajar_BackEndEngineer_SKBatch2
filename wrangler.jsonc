{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backendengineer-skbatch2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      // Nama binding: diakses di kode sebagai c.env.DB
      "binding": "DB",
      "database_name": "backendengineer-skbatch2-db",
      // Ganti dengan ID dari `npx wrangler d1 create backendengineer-skbatch2-db` sebelum deploy.
      // Untuk development lokal, nilai placeholder ini sudah cukup.
      "database_id": "f2471189-2b9e-4073-8d45-70d5fee9ad9c",
      "migrations_dir": "migrations"
    }
  ],
  // Rate limiting bawaan Workers (tersedia di free plan, tidak memakai kuota D1/KV).
  // Diakses di kode sebagai c.env.RATE_LIMITER.limit({ key }).
  // `period` hanya boleh 10 atau 60 (detik).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
  // Secret API_KEY TIDAK ditulis di sini.
  // Lokal: simpan di file .dev.vars  |  Produksi: `npx wrangler secret put API_KEY`
}